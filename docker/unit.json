{
"listeners": {
    "*:8080": {
        "pass": "routes",
        "forwarded": {
        "client_ip": "X-Forwarded-For",
        "protocol": "X-Forwarded-Proto",
        "source": ["0.0.0.0/0", "::/0"]
        }
    }
    },
  "routes": [
    {
      "match": {
        "uri": [
          "/build/*",
          "*.css",
          "*.js",
          "*.cjs",
          "*.mjs",
          "*.map",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.gif",
          "*.ico",
          "*.svg",
          "*.webp",
          "*.woff",
          "*.woff2",
          "*.avif",
          "*.json",
          "*.ogg",
          "*.glb"
        ]
      },
      "action": {
        "share": "/var/www/html/public$uri",
        "response_headers": { "Cache-Control": "public, max-age=31536000, immutable" },
        "fallback": { "pass": "applications/laravel" }
      }
    },
    { "action": { "pass": "applications/laravel" } }
  ],
  "applications": {
    "laravel": {
      "type": "php",
      "processes": { "max": 16, "spare": 2 },
      "root": "/var/www/html/public",
      "script": "index.php",
      "options": {
        "admin": { "memory_limit": "512M", "expose_php": "0" },
        "user": { "upload_max_filesize": "20M", "post_max_size": "20M" }
      }
    }
  }
}
